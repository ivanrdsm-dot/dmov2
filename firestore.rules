rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══ RBAC v3 ══════════════════════════════════════════════════════════
       - OFICINA = sesión Google (no anónima) con perfil activo en dmov_usuarios.
       - No existe acceso anónimo ni público a ninguna colección (RBAC v4).
       Todo queda cerrado a oficina; borrar, solo admin. */

    function noAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function tienePerfil() {
      return exists(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid)).data;
    }
    function esOficina() {
      return noAnon() && tienePerfil() && perfil().activo == true;
    }
    function esAdmin() {
      return esOficina() && perfil().rol == "admin";
    }

    /* ── Operación (rutas, choferes, ubicaciones) · CERRADO a oficina ─────────
       Antes: rutas y ubicaciones se leían sin login y cualquier sesión anónima
       podía modificarlas; los códigos de acceso de choferes eran legibles.
       Ahora solo entra la oficina con sesión de Google y perfil activo.
       El rastreo público y la app de chofer vuelven con identidad real y
       validación en servidor (Fase 1); hasta entonces no hay acceso anónimo. */
    match /rutas/{rutaId}            { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /driverLocations/{choferId}{ allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    match /choferes/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /gastosChofer/{id}         { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /jornadas/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /mensajes/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /alertas/{id}              { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /alerts/{id} {                          // legacy migrada — congelada
      allow read: if esOficina();
      allow write: if false;
    }

    /* ── Perfiles RBAC ── */
    match /dmov_usuarios/{uid} {
      allow read: if noAnon();                    // resolución + claim por email
      // Self-signup never grants office/admin privileges. No email-based role claim.
      allow create: if (esAdmin() && uid != request.auth.uid)
        || (noAnon() && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid','nombre','email','rol','activo','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.rol == 'operaciones'
          && request.resource.data.activo == false);
      allow update: if noAnon() && (
        (esAdmin() && uid != request.auth.uid)
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','pin','pinSaltED','pinCreadoEn'])));
      // Admins cannot accidentally remove their own access.
      allow delete: if esAdmin() && uid != request.auth.uid;
    }

    /* ── Financieras: SOLO oficina; borrar SOLO admin ── */
    match /facturas/{id} {
      allow read, create: if esOficina();
      allow update: if esOficina() && (
        !('cfdiArchiveLocked' in resource.data) || resource.data.cfdiArchiveLocked != true
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notas','status','fechaPago','fechaVenc','emailCliente',
             'intranetFolio','intranetFecha','intranetEstatus','intranetDirector','seguimiento','seguimientoFecha','cotizacionFolio','cotizacionId']));
      allow delete: if esAdmin() && (!('cfdiArchiveLocked' in resource.data) || resource.data.cfdiArchiveLocked != true);
    }
    match /pagos/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /pagosProveedores/{id}  { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /presupuestos/{id}      { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /cotizaciones/{id}      { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /cuentas/{id}           { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    /* Catálogo de planes del grupo (número → empresa, RFC, director de intranet):
       lo lee toda la oficina (formulario de facturas); lo edita solo admin. */
    match /planes/{id}            { allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    /* Cierres contables cargados desde la balanza: lectura de oficina, escritura admin. */
    match /cierresContables/{id}  { allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    match /viaticos/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /prospeccion/{id}       { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /proyectos/{id}         { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /plantillasCotizador/{id}{ allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /unidades/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /entregas/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }

    /* ── Servicios (Fase 0 · alta manual) ────────────────────────────────────
       - Oficina registra y edita; NADIE borra (ni admin): los servicios se cancelan.
       - Folio, autor y fecha de creación son inmutables.
       - El precio aprobado solo lo fija un admin (regla de negocio #2).
       - La bitácora de eventos solo se agrega: con autor real y hora del servidor. */
    function tocaPrecio(campos) {
      return campos.hasAny(['precio','precioAprobadoPor','precioAprobadoEn']);
    }
    /* El folio debe ser el que el contador emite EN ESTA MISMA transacción:
       así no se puede reutilizar un folio ya emitido. */
    function folioRecienEmitido(folio) {
      let ruta = /databases/$(database)/documents/contadores/$('servicios-' + folio.split('-')[1]);
      return getAfter(ruta).data.ultimoFolio == folio
        && (!exists(ruta) || getAfter(ruta).data.n == get(ruta).data.n + 1);
    }
    match /servicios/{id} {
      allow read: if esOficina();
      allow create: if esOficina()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'Solicitud'
        && request.resource.data.folio is string
        && request.resource.data.folio.matches('SRV-20[0-9]{2}-[0-9]{4,}')
        && folioRecienEmitido(request.resource.data.folio)
        && (!tocaPrecio(request.resource.data.keys()) || esAdmin());
      allow update: if esOficina()
        && request.resource.data.folio == resource.data.folio
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.creadoEn == resource.data.creadoEn
        && (!tocaPrecio(request.resource.data.diff(resource.data).affectedKeys()) || esAdmin());
      allow delete: if false;
      match /eventos/{eventoId} {
        allow read: if esOficina();
        allow create: if esOficina()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* Contadores de folio: solo avanzan de uno en uno. */
    match /contadores/{id} {
      allow read: if esOficina();
      allow create: if esOficina() && request.resource.data.n == 1;
      allow update: if esOficina() && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Private fiscal registry: UUID and both byte hashes are unique and immutable.
    match /cfdi_archivo/{uuid} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && uuid.matches('[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}')
        && request.resource.data.keys().hasOnly(['uuid','facturaId','facturaFolio','facturaFingerprint','facturaTotal','empresa','cfdi','xml','pdf','estado','createdBy','createdAt','actualizadoAt'])
        && request.resource.data.uuid == uuid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.cfdi.estadoSat == 'no_consultado'
        && request.resource.data.xml.sha256.matches('[a-f0-9]{64}')
        && request.resource.data.pdf.sha256.matches('[a-f0-9]{64}')
        && request.resource.data.xml.sha256 != request.resource.data.pdf.sha256
        && exists(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId))
        && getAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.cfdiArchiveLocked == true
        && request.resource.data.facturaTotal == get(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.total
        && request.resource.data.empresa == get(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.empresa
        && getAfter(/databases/$(database)/documents/cfdi_hashes/$(request.resource.data.xml.sha256)).data.uuid == uuid
        && getAfter(/databases/$(database)/documents/cfdi_hashes/$(request.resource.data.pdf.sha256)).data.uuid == uuid;
      allow update: if esAdmin() && resource.data.createdBy == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'archivado'
        && request.resource.data.actualizadoAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoAt']);
      allow delete: if false;
    }
    match /cfdi_hashes/{hash} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && hash.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['uuid','facturaId'])
        && getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.facturaId == request.resource.data.facturaId
        && (getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.xml.sha256 == hash
          || getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.pdf.sha256 == hash);
      allow update, delete: if false;
    }

    /* ── Default seguro: lo no listado, solo admin ── */
    match /{top}/{document=**} {
      allow read, write: if esAdmin() && !(top in ['cfdi_archivo','cfdi_hashes','dmov_usuarios','facturas','servicios','contadores']);
    }
  }
}

