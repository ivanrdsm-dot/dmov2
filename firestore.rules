rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══ RBAC v3 ══════════════════════════════════════════════════════════
       - OFICINA = sesión Google (no anónima) con perfil activo en dmov_usuarios.
       - No existe acceso anónimo ni público a ninguna colección (RBAC v4).
       Todo queda cerrado a oficina; borrar, solo admin. */

    function noAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function tienePerfil() {
      return exists(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid)).data;
    }
    function esOficina() {
      return noAnon() && tienePerfil() && perfil().activo == true;
    }
    function esAdmin() {
      return esOficina() && perfil().rol == "admin";
    }
    /* CHOFER = cuenta propia (no anónima) ligada por la oficina en choferes_auth/{uid}.
       Solo LEE lo suyo. No escribe nada directo: todo pasa por Cloud Functions,
       que validan identidad, equipo, ubicación y geocerca en el servidor. */
    function esChofer() {
      return noAnon() && exists(/databases/$(database)/documents/choferes_auth/$(request.auth.uid));
    }
    /* Papelera: estas colecciones solo se borran si en el mismo lote queda la copia
       en papelera/{coleccion}__{id} (ver papelera.js). Nadie edita ni borra la papelera. */
    function copiaNueva(pid) {
      return existsAfter(/databases/$(database)/documents/papelera/$(pid))
        && getAfter(/databases/$(database)/documents/papelera/$(pid)).data.borradoEn == request.time;
    }
    function conCopia(col, id) {
      return copiaNueva(col + '__' + id) || copiaNueva(col + '__' + id + '__2') || copiaNueva(col + '__' + id + '__3');
    }
    function miChoferId() {
      return get(/databases/$(database)/documents/choferes_auth/$(request.auth.uid)).data.choferId;
    }

    /* ── Operación (rutas, choferes, ubicaciones) · CERRADO a oficina ─────────
       Antes: rutas y ubicaciones se leían sin login y cualquier sesión anónima
       podía modificarlas; los códigos de acceso de choferes eran legibles.
       Ahora solo entra la oficina con sesión de Google y perfil activo.
       El rastreo público y la app de chofer vuelven con identidad real y
       validación en servidor (Fase 1); hasta entonces no hay acceso anónimo. */
    match /rutas/{rutaId}            { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('rutas', rutaId); }
    match /driverLocations/{choferId}{ allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    match /choferes/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('choferes', id); }
    match /gastosChofer/{id}         { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /jornadas/{id}             { allow read: if esOficina() || (esChofer() && resource.data.choferId == miChoferId()); allow create, update: if esOficina(); allow delete: if esAdmin(); }
    match /mensajes/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /alertas/{id}              { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /alerts/{id} {                          // legacy migrada — congelada
      allow read: if esOficina();
      allow write: if false;
    }

    /* ── Perfiles RBAC ── */
    match /dmov_usuarios/{uid} {
      allow read: if noAnon();                    // resolución + claim por email
      // Self-signup never grants office/admin privileges. No email-based role claim.
      allow create: if (esAdmin() && uid != request.auth.uid)
        || (noAnon() && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid','nombre','email','rol','activo','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.rol == 'operaciones'
          && request.resource.data.activo == false);
      allow update: if noAnon() && (
        (esAdmin() && uid != request.auth.uid)
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','pin','pinSaltED','pinCreadoEn'])));
      // Admins cannot accidentally remove their own access.
      allow delete: if esAdmin() && uid != request.auth.uid;
    }

    /* ── Financieras: SOLO oficina; borrar SOLO admin ── */
    match /facturas/{id} {
      allow read, create: if esOficina();
      allow update: if esOficina() && (
        !('cfdiArchiveLocked' in resource.data) || resource.data.cfdiArchiveLocked != true
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notas','status','fechaPago','fechaVenc','emailCliente',
             'intranetFolio','intranetFecha','intranetEstatus','intranetDirector','seguimiento','seguimientoFecha','cotizacionFolio','cotizacionId']));
      allow delete: if esAdmin() && (!('cfdiArchiveLocked' in resource.data) || resource.data.cfdiArchiveLocked != true) && conCopia('facturas', id);
    }
    match /pagos/{id}             { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /pagosProveedores/{id}  { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('pagosProveedores', id); }
    match /presupuestos/{id}      { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('presupuestos', id); }
    match /cotizaciones/{id}      { allow read, create, update: if esOficina(); allow delete: if esAdmin(); }
    match /cuentas/{id}           { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('cuentas', id); }
    /* Catálogo de planes del grupo (número → empresa, RFC, director de intranet):
       lo lee toda la oficina (formulario de facturas); lo edita solo admin. */
    match /planes/{id}            { allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    /* Cierres contables cargados desde la balanza: lectura de oficina, escritura admin. */
    match /cierresContables/{id}  { allow read: if esOficina(); allow create, update, delete: if esAdmin(); }
    match /viaticos/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('viaticos', id); }
    match /prospeccion/{id}       { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('prospeccion', id); }
    match /proyectos/{id}         { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('proyectos', id); }
    match /plantillasCotizador/{id}{ allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('plantillasCotizador', id); }
    match /unidades/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('unidades', id); }
    match /entregas/{id}          { allow read, create, update: if esOficina(); allow delete: if esAdmin() && conCopia('entregas', id); }

    /* ── Servicios (Fase 0 · alta manual) ────────────────────────────────────
       - Oficina registra y edita; NADIE borra (ni admin): los servicios se cancelan.
       - Folio, autor y fecha de creación son inmutables.
       - El precio aprobado solo lo fija un admin (regla de negocio #2).
       - La bitácora de eventos solo se agrega: con autor real y hora del servidor. */
    function tocaPrecio(campos) {
      return campos.hasAny(['precio','precioAprobadoPor','precioAprobadoEn']);
    }
    /* El folio debe ser el que el contador emite EN ESTA MISMA transacción:
       así no se puede reutilizar un folio ya emitido. */
    function folioRecienEmitido(coleccion, folio) {
      let ruta = /databases/$(database)/documents/contadores/$(coleccion + '-' + folio.split('-')[1]);
      return getAfter(ruta).data.ultimoFolio == folio
        && (!exists(ruta) || getAfter(ruta).data.n == get(ruta).data.n + 1);
    }
    /* El precio de un servicio nuevo puede venir de una cotización que un admin ya
       aprobó y el cliente aceptó: debe coincidir exacto con lo aprobado. */
    function precioDeCotizacionAceptada(d) {
      let c = get(/databases/$(database)/documents/cotizaciones_logistica/$(d.cotizacionId)).data;
      return !('precioAprobadoEn' in d)
        && c.estado == 'Aceptada'
        && !('servicioId' in c)
        && c.empresa == d.empresa
        && c.folio == d.cotizacionFolio
        && c.precioAprobado == d.precio
        && c.aprobadoPor == d.precioAprobadoPor;
    }
    /* Campos que solo escribe el servidor: totales de costos, link de seguimiento y encuesta del cliente. */
    function camposDeCostoServidor() { return ['costoTotal','costosN','costosPorConcepto','costosActualizadosEn','seguimientoToken','seguimientoCreadoEn','encuestaRespondida','encuestaCalificacion','facturaEstado','facturaActualizadaEn']; }
    match /servicios/{id} {
      allow read: if esOficina() || (esChofer() && resource.data.choferId == miChoferId());
      allow create: if esOficina()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'Solicitud'
        && request.resource.data.folio is string
        && request.resource.data.folio.matches('SRV-20[0-9]{2}-[0-9]{4,}')
        && folioRecienEmitido('servicios', request.resource.data.folio)
        && !request.resource.data.keys().hasAny(camposDeCostoServidor())
        && (!tocaPrecio(request.resource.data.keys()) || esAdmin() || precioDeCotizacionAceptada(request.resource.data));
      allow update: if esOficina()
        && request.resource.data.folio == resource.data.folio
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.creadoEn == resource.data.creadoEn
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeCostoServidor())
        && (!tocaPrecio(request.resource.data.diff(resource.data).affectedKeys()) || esAdmin());
      allow delete: if false;
      /* Costos reales: la oficina los captura; nadie los edita ni borra. Uno mal
         capturado se anula una sola vez, con motivo. El total lo escribe el servidor. */
      match /encuesta/{e} {
        allow read: if esOficina();
        allow write: if false;
      }
      match /costos/{costoId} {
        allow read: if esOficina();
        allow create: if esOficina()
          && request.resource.data.keys().hasOnly(['concepto','monto','nota','actorUid','actorNombre','ts'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.concepto in ['Proveedor / flete externo','Combustible','Casetas','Viáticos','Ayudantes / maniobra','Chofer','Otro']
          && request.resource.data.monto is number
          && request.resource.data.monto > 0 && request.resource.data.monto < 10000000
          && (request.resource.data.concepto != 'Otro' || (request.resource.data.nota is string && request.resource.data.nota.size() > 0))
          && exists(/databases/$(database)/documents/servicios/$(id));
        allow update: if esOficina()
          && !('anulado' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado','anuladoPor','anuladoNombre','anuladoEn','motivoAnulacion'])
          && request.resource.data.anulado == true
          && request.resource.data.anuladoPor == request.auth.uid
          && request.resource.data.anuladoEn == request.time
          && request.resource.data.motivoAnulacion is string && request.resource.data.motivoAnulacion.size() > 0;
        allow delete: if false;
      }
      /* Ruta del servicio: paradas y posiciones las escribe SOLO el servidor. */
      match /paradas/{paradaId} {
        allow read: if esOficina()
          || (esChofer() && get(/databases/$(database)/documents/servicios/$(id)).data.choferId == miChoferId());
        allow write: if false;
      }
      match /posiciones/{loteId} {
        allow read: if esOficina();
        allow write: if false;
      }
      match /eventos/{eventoId} {
        allow read: if esOficina();
        allow create: if esOficina()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* ── Solicitudes (bandeja de entrada) ────────────────────────────────────
       Las que llegan por correo o Slack las crea el servidor (Cloud Function).
       La oficina solo puede: registrar una manual, cambiar su estado y anotar.
       El mensaje original, el folio, el canal y las horas de recepción y acuse
       son inmutables; nadie borra. */
    function solicitudInmutables() {
      return ['folio','canal','idExterno','hilo','origen','creadoPor','recibidaEn','registradaEn',
              'asunto','texto','textoTruncado','adjuntos','remitenteNombre','remitenteCorreo','automatico','acuseEnviadoEn'];
    }
    match /solicitudes/{id} {
      allow read: if esOficina();
      allow create: if esOficina()
        && request.resource.data.origen == 'manual'
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.registradaEn == request.time
        && request.resource.data.recibidaEn is timestamp
        && request.resource.data.recibidaEn <= request.time
        && request.resource.data.estado == 'Nueva'
        && request.resource.data.canal in ['Correo','Slack','WhatsApp','Teléfono','En persona']
        && !request.resource.data.keys().hasAny(['acuseEnviadoEn','primeraRespuestaEn'])
        && request.resource.data.folio is string
        && request.resource.data.folio.matches('SOL-20[0-9]{2}-[0-9]{4,}')
        && folioRecienEmitido('solicitudes', request.resource.data.folio);
      allow update: if esOficina()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(solicitudInmutables())
        && request.resource.data.estado in ['Nueva','En revisión','Respondida','Convertida','Descartada']
        // La primera respuesta se fija una sola vez y con la hora del servidor.
        && (!('primeraRespuestaEn' in request.resource.data.diff(resource.data).affectedKeys())
            || (!('primeraRespuestaEn' in resource.data) && request.resource.data.primeraRespuestaEn == request.time));
      allow delete: if false;
      match /eventos/{eventoId} {
        allow read: if esOficina();
        allow create: if esOficina()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* ── Cotizaciones de logística ───────────────────────────────────────────
       La oficina guarda la propuesta que calculó el cotizador; el precio que ve
       el cliente lo fija SOLO un admin. El cálculo guardado es inmutable, las
       transiciones de estado son las únicas válidas y nadie borra. */
    function cotPrecio() { return ['precioAprobado','aprobadoPor','aprobadoPorUid','aprobadoEn']; }
    function cotInmutables() {
      return ['folio','creadoPor','creadoPorNombre','creadoEn','entrada','resultado','precioPropuesto',
              'solicitudId','solicitudFolio','solicitudCanal','solicitudRecibidaEn','sustituyeA','empresa'];
    }
    function cotTransicion(de, a) {
      return de == a
        || (de == 'Propuesta' && a == 'Aprobada' && esAdmin())
        || (de == 'Aprobada' && a == 'Enviada')
        || (de == 'Enviada' && a in ['Aceptada','Rechazada'])
        || (de in ['Propuesta','Aprobada','Enviada'] && a == 'Cancelada');
    }
    match /papelera/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['coleccion','docId','datos','borradoPorUid','borradoPorNombre','motivo','borradoEn'])
        && request.resource.data.coleccion is string && request.resource.data.docId is string
        && (id == request.resource.data.coleccion + '__' + request.resource.data.docId
            || id == request.resource.data.coleccion + '__' + request.resource.data.docId + '__2'
            || id == request.resource.data.coleccion + '__' + request.resource.data.docId + '__3')
        && exists(/databases/$(database)/documents/$(request.resource.data.coleccion)/$(request.resource.data.docId))
        && request.resource.data.datos is map
        && request.resource.data.borradoPorUid == request.auth.uid
        && request.resource.data.borradoEn == request.time;
      // Recuperar: solo se anota quién y cuándo, una vez, y el registro debe quedar de vuelta.
      allow update: if esAdmin()
        && !('recuperadoEn' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recuperadoPorUid','recuperadoEn'])
        && request.resource.data.recuperadoPorUid == request.auth.uid
        && request.resource.data.recuperadoEn == request.time
        && existsAfter(/databases/$(database)/documents/$(resource.data.coleccion)/$(resource.data.docId));
      allow delete: if false;
    }
    match /cotizaciones_logistica/{id} {
      allow read: if esOficina();
      allow create: if esOficina()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'Propuesta'
        && request.resource.data.precioPropuesto is number
        && request.resource.data.precioPropuesto > 0
        && request.resource.data.resultado is map
        && request.resource.data.entrada is map
        && !request.resource.data.keys().hasAny(cotPrecio())
        && !request.resource.data.keys().hasAny(['servicioId','servicioFolio'])
        && request.resource.data.folio is string
        && request.resource.data.folio.matches('COT-20[0-9]{2}-[0-9]{4,}')
        && folioRecienEmitido('cotizaciones_logistica', request.resource.data.folio);
      allow update: if esOficina()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(cotInmutables())
        && cotTransicion(resource.data.estado, request.resource.data.estado)
        // El precio aprobado solo se fija al aprobar, por un admin y con la hora del servidor.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(cotPrecio())
            || (esAdmin() && resource.data.estado == 'Propuesta' && request.resource.data.estado == 'Aprobada'
                && request.resource.data.precioAprobado is number && request.resource.data.precioAprobado > 0
                && request.resource.data.aprobadoEn == request.time
                && request.resource.data.aprobadoPorUid == request.auth.uid))
        && (request.resource.data.estado != 'Aprobada' || resource.data.estado == 'Aprobada'
            || request.resource.data.diff(resource.data).affectedKeys().hasAll(cotPrecio()))
        // Solo una cotización aceptada se liga a un servicio, y una sola vez.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['servicioId','servicioFolio'])
            || (resource.data.estado == 'Aceptada' && !('servicioId' in resource.data)));
      allow delete: if false;
      match /eventos/{eventoId} {
        allow read: if esOficina();
        allow create: if esOficina()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* Estado de conectores (latidos): lo escribe solo el servidor. */
    match /sistema/{id} {
      allow read: if esOficina();
      allow write: if false;
    }
    /* ── Catálogos operativos: puntos de entrega y proveedores ───────────────
       Oficina los mantiene; nadie borra (se dan de baja). Cada guardado deja
       su registro en `cambios`, que solo se agrega. */
    match /puntos_entrega/{id} {
      allow read, create, update: if esOficina();
      allow delete: if false;
      match /cambios/{c} {
        allow read: if esOficina();
        allow create: if esOficina() && request.resource.data.actorUid == request.auth.uid && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    match /proveedores/{id} {
      allow read, create, update: if esOficina();
      allow delete: if false;
      match /cambios/{c} {
        allow read: if esOficina();
        allow create: if esOficina() && request.resource.data.actorUid == request.auth.uid && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* ── Fase 1: identidad y rastreo del chofer (todo lo escribe el servidor) ── */
    match /choferes_auth/{uid} {
      allow read: if esOficina() || (noAnon() && request.auth.uid == uid);
      allow write: if false;
    }
    match /ubicaciones/{choferId} {
      allow read: if esOficina();
      allow write: if false;
    }
    /* ── Tarifario: lo consulta la oficina; los precios solo los cambia un admin.
       Nada se borra (se da de baja) y el historial de cambios solo se agrega. */
    match /tarifario/{id} {
      allow read: if esOficina();
      allow create, update: if esAdmin();
      allow delete: if false;
      match /cambios/{c} {
        allow read: if esOficina();
        allow create: if esAdmin() && request.resource.data.actorUid == request.auth.uid && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
    /* Contadores de folio: solo avanzan de uno en uno. */
    match /contadores/{id} {
      allow read: if esOficina();
      allow create: if esOficina() && request.resource.data.n == 1;
      allow update: if esOficina() && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Private fiscal registry: UUID and both byte hashes are unique and immutable.
    match /cfdi_archivo/{uuid} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && uuid.matches('[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}')
        && request.resource.data.keys().hasOnly(['uuid','facturaId','facturaFolio','facturaFingerprint','facturaTotal','empresa','cfdi','xml','pdf','estado','createdBy','createdAt','actualizadoAt'])
        && request.resource.data.uuid == uuid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.cfdi.estadoSat == 'no_consultado'
        && request.resource.data.xml.sha256.matches('[a-f0-9]{64}')
        && request.resource.data.pdf.sha256.matches('[a-f0-9]{64}')
        && request.resource.data.xml.sha256 != request.resource.data.pdf.sha256
        && exists(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId))
        && getAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.cfdiArchiveLocked == true
        && request.resource.data.facturaTotal == get(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.total
        && request.resource.data.empresa == get(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.empresa
        && getAfter(/databases/$(database)/documents/cfdi_hashes/$(request.resource.data.xml.sha256)).data.uuid == uuid
        && getAfter(/databases/$(database)/documents/cfdi_hashes/$(request.resource.data.pdf.sha256)).data.uuid == uuid;
      allow update: if esAdmin() && resource.data.createdBy == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'archivado'
        && request.resource.data.actualizadoAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoAt']);
      allow delete: if false;
    }
    match /cfdi_hashes/{hash} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && hash.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['uuid','facturaId'])
        && getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.facturaId == request.resource.data.facturaId
        && (getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.xml.sha256 == hash
          || getAfter(/databases/$(database)/documents/cfdi_archivo/$(request.resource.data.uuid)).data.pdf.sha256 == hash);
      allow update, delete: if false;
    }

    /* ── Default seguro: lo no listado, solo admin ── */
    match /{top}/{document=**} {
      allow read, write: if esAdmin() && !(top in ['cfdi_archivo','cfdi_hashes','dmov_usuarios','facturas','servicios','contadores','solicitudes','sistema','puntos_entrega','proveedores','choferes_auth','ubicaciones','tarifario','cotizaciones_logistica',
        // Con papelera: el borrado lo controla su propia regla (copia obligatoria); la papelera no se edita.
        'papelera','rutas','choferes','pagosProveedores','presupuestos','cuentas','viaticos','prospeccion','proyectos','plantillasCotizador','unidades','entregas']);
    }
  }
}

