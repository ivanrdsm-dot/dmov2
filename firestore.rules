rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tracking público — clientes ven su ruta sin login
    match /rutas/{rutaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ubicación del chofer en vivo — el tracking público /track/:id la lee
    match /driverLocations/{choferId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Alertas — colección canónica unificada (F0). El panel autenticado la lee;
    // los choferes (auth anónima) escriben SOS/geofence aquí.
    match /alertas/{alertId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Colección legacy "alerts" (inglés) — migrada a "alertas" en F0.
    // Escritura bloqueada para que nada nuevo caiga aquí por error.
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Perfiles de usuario RBAC — solo el propio usuario o un admin puede escribir
    match /dmov_usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid)).data.rol == "admin"
      );
      // Permitir create propio perfil (primer login — no hay doc aún)
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // ── Protección anti-borrado en colecciones financieras (F0.5 parcial) ──
    // Crear/editar sigue abierto a cualquier sesión autenticada (la oficina aún
    // opera con auth anónima), pero BORRAR registros financieros exige que el
    // uid de la sesión tenga perfil admin en dmov_usuarios (sesión Google real).
    // Esto frena la destrucción masiva de datos desde sesiones anónimas.
    function esAdmin() {
      return exists(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/dmov_usuarios/$(request.auth.uid)).data.rol == "admin";
    }
    match /facturas/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }
    match /pagos/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }
    match /pagosProveedores/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }
    match /presupuestos/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }
    match /cuentas/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }
    match /viaticos/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && esAdmin();
    }

    // Todo lo demás requiere Firebase Auth
    // (Google para oficina, Anónimo para choferes)
    // NOTA F0: crear/editar sigue permisivo — el RBAC completo requiere migrar
    // la oficina entera a Google Sign-In (ver EVOLUCION-THE-MOVIMIENTO.md §7).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
